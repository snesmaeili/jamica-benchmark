{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019NJs3XauLcqbCgMMxuQjYn","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Render the chunk-size study report (self-contained HTML) — REAL-data primary (bleeding-edge).\n3\t\n4\tThesis: chunk size is the dominant performance variable; every implementation is strongly\n5\tchunk-sensitive; defaults are footguns. On the real ds004505 workload (25-subject median, H100,\n6\tlatest main) jamica is fastest at every chunk and leanest at full-batch. The synthetic\n7\t\"flat curve\" that once looked like robustness was a JIT-compile artifact (methodology section).\n8\tCPU absolute timings carry a node-contention caveat (see NOTES_measurement.md); CPU *memory* is clean.\n9\t\"\"\"\n10\timport math, os\n11\t\n12\tFULL = 262144\n13\tIMPLS = [\"jamica\", \"pamica\", \"pyamica\", \"scott\"]\n14\tLABEL = {\"jamica\":\"jamica\",\"pamica\":\"pAMICA (sccn)\",\"pyamica\":\"pyamica\",\"scott\":\"scott-huberty\"}\n15\tKNOB  = {\"jamica\":\"chunk_size\",\"pamica\":\"block_size\",\"pyamica\":\"chunk_t\",\"scott\":\"batch_size\",\"fortran\":\"block_size\"}\n16\tCOMMIT= {\"jamica\":\"df18b5e\",\"pamica\":\"0c4da39\",\"pyamica\":\"a8a4d7e\",\"scott\":\"e15e158\",\"fortran\":\"665b577\"}\n17\tCOLOR = {\"jamica\":\"#6366f1\",\"pamica\":\"#d97706\",\"pyamica\":\"#0d9488\",\"scott\":\"#e11d48\",\"fortran\":\"#7c3aed\"}\n18\t\n19\t# ===== REAL ds004505, latest main, 25-subject median (GPU) : chunk -> (fit_s, vram_gb) =====\n20\tGPU = {\n21\t \"jamica\":   {1024:(29.2,2.19),4096:(11.0,2.19),16384:(6.8,2.19),65536:(5.6,3.68),FULL:(5.2,8.14)},\n22\t \"pamica\":  {1024:(139.6,0.58),4096:(36.9,0.64),16384:(14.3,0.86),65536:(11.6,1.75),FULL:(9.2,19.25)},\n23\t \"pyamica\": {1024:(81.3,1.66),4096:(21.1,1.66),16384:(12.7,1.66),65536:(11.7,3.07),FULL:(9.7,28.30)},\n24\t \"scott\":   {1024:(172.4,0.58),4096:(45.2,0.62),16384:(15.4,0.77),65536:(10.1,1.38)},  # full = OOM\n25\t}\n26\tGPU_OOM = {\"scott\": \"full\"}\n27\t# fit-time spread (min,max) across 25 subjects, for the band\n28\tGPU_BAND = {\n29\t \"jamica\":   {1024:(20.8,34.7),4096:(9.1,29.9),16384:(6.0,43.0),65536:(5.0,10.5),FULL:(4.1,30.5)},\n30\t \"pamica\":  {1024:(99.2,170.4),4096:(29.2,49.8),16384:(11.6,40.6),65536:(8.2,34.5),FULL:(7.0,33.5)},\n31\t \"pyamica\": {1024:(58.5,98.8),4096:(15.0,26.2),16384:(9.4,15.8),65536:(8.4,14.3),FULL:(7.0,12.1)},\n32\t \"scott\":   {1024:(123.3,213.5),4096:(36.8,72.4),16384:(13.3,85.7),65536:(7.4,16.8)},\n33\t}\n34\t# ===== REAL CPU memory (peak RSS, GB), 5-subject median : chunk -> rss (timing is contended, see note) =====\n35\tCPU_RSS = {\n36\t \"jamica\":   {1024:2.23,4096:2.27,16384:2.23,65536:3.68,FULL:20.62},\n37\t \"pamica\":  {1024:1.58,4096:1.74,16384:2.36,65536:2.63,FULL:19.57},\n38\t \"pyamica\": {4096:1.94,16384:2.75,65536:3.81,FULL:27.21},\n39\t \"scott\":   {1024:2.06,4096:2.06,16384:2.06,65536:2.31},\n40\t \"fortran\": {1024:0.72,4096:0.75,16384:0.86,65536:1.32,FULL:9.97},\n41\t}\n42\t# REAL CPU fit-time (s), throttled %4 rerun, 5 subjects. CPU_FIT = min across subjects\n43\t# (best observed ≈ least-contended, the clean lower-bound curve); CPU_FIT_MED = median (still\n44\t# carries residual node contention + per-subject data-size heterogeneity, shown for context).\n45\tCPU_FIT = {  # min across subjects — the clean curve\n46\t \"jamica\":   {1024:155.0,4096:156.5,16384:162.3,65536:181.6,FULL:288.3},\n47\t \"scott\":   {1024:195.0,4096:164.5,16384:172.3,65536:235.5},\n48\t \"pyamica\": {4096:2008.4,16384:724.2,65536:776.9,FULL:903.2},\n49\t \"pamica\":  {1024:241.3,4096:261.0,16384:341.7,65536:833.0,FULL:754.2},\n50\t \"fortran\": {1024:639.8,4096:589.5,16384:730.3,65536:764.3,FULL:790.9},\n51\t}\n52\tCPU_FIT_MED = {  # median (contention-noisy, context only)\n53\t \"jamica\":{1024:276.4,4096:220.9,16384:186.6,65536:255.7,FULL:398.8},\n54\t \"scott\":{1024:257.9,4096:290.7,16384:268.9,65536:321.4},\n55\t \"pyamica\":{4096:2345.0,16384:969.9,65536:980.8,FULL:980.7},\n56\t \"pamica\":{1024:534.9,4096:431.3,16384:408.7,65536:911.7,FULL:815.8},\n57\t \"fortran\":{1024:759.7,4096:812.4,16384:845.0,65536:862.8,FULL:960.9},\n58\t}\n59\t# Why a CPU cell has no number (not just \"missing\"):\n60\tCPU_FIT_MISS = {(\"pyamica\",1024):(\"&gt;1h\",\"bad\"),   # exceeded the 3600s runner timeout (pathological small-block)\n61\t                (\"scott\",FULL):(\"OOM\",\"bad\")}         # full-batch out-of-memory (~30s failure)\n62\t# Real each-at-own-optimum on GPU (25-subj median), fit + vram\n63\tREAL_OPT = [(\"jamica\",\"full-batch\",5.2,8.1),(\"pamica\",\"full-batch\",9.2,19.3),\n64\t            (\"pyamica\",\"full-batch\",9.7,28.3),(\"scott\",\"65536\",10.1,1.4)]\n65\t# pAMICA default sensitivity (the 47x), GPU 25-subj median\n66\tREAL_PAM = [(\"512 (default)\",139.6,0.58,\"artifact\"),(\"16384 (tuned)\",14.3,0.86,\"tuned\"),\n67\t            (\"full-batch (best)\",9.2,19.25,\"best\")]\n68\t\n69\tdef xlog(c): return math.log2(FULL*4 if c==FULL else c)\n70\tXT=[1024,4096,16384,65536,FULL]; XMIN,XMAX=math.log2(1024)-0.4,xlog(FULL)+0.4\n71\t\n72\tdef chart(series, band, ylab, ylog, title, sub, impls, oom=None):\n73\t    W,H=520,340; ml,mr,mt,mb=56,14,32,52; pw,ph=W-ml-mr,H-mt-mb\n74\t    def X(c): return ml+(xlog(c)-XMIN)/(XMAX-XMIN)*pw\n75\t    allv=[v for im in impls for v in series[im].values()]\n76\t    if band: allv+=[b for im in impls for c in series[im] if im in band and c in band[im] for b in band[im][c]]\n77\t    vmax=max(allv); vmin=min(v for v in allv if v>0)\n78\t    if ylog:\n79\t        lo,hi=math.log10(vmin*0.8),math.log10(vmax*1.25)\n80\t        def Y(v): return mt+ph-(math.log10(max(v,vmin*0.5))-lo)/(hi-lo)*ph\n81\t    else:\n82\t        hi=vmax*1.12; lo=0\n83\t        def Y(v): return mt+ph-(v-lo)/(hi-lo)*ph\n84\t    s=[f'<svg viewBox=\"0 0 {W} {H}\" class=\"chart\" role=\"img\" aria-label=\"{title}\">']\n85\t    s.append(f'<text x=\"{ml}\" y=\"16\" class=\"ct\">{title}</text>')\n86\t    s.append(f'<text x=\"{ml}\" y=\"{H-6}\" class=\"cx\">chunk / block size (samples) →</text>')\n87\t    s.append(f'<text transform=\"translate(14,{mt+ph/2}) rotate(-90)\" class=\"cy\">{ylab}</text>')\n88\t    if ylog:\n89\t        ticks=[]; d0=1\n90\t        while d0<=vmax*1.25:\n91\t            for m0 in (1,2,5):\n92\t                if vmin*0.7<=d0*m0<=vmax*1.25: ticks.append(d0*m0)\n93\t            d0*=10\n94\t    else: ticks=[hi*i/4 for i in range(5)]\n95\t    for t in ticks:\n96\t        y=Y(t); s.append(f'<line x1=\"{ml}\" y1=\"{y:.1f}\" x2=\"{W-mr}\" y2=\"{y:.1f}\" class=\"grid\"/>')\n97\t        lab=f'{t:.0f}' if t>=1 else f'{t:.1f}'\n98\t        s.append(f'<text x=\"{ml-6}\" y=\"{y+3:.1f}\" class=\"cyt\">{lab}</text>')\n99\t    for c in XT:\n100\t        x=X(c); lab=\"full\" if c==FULL else f'{c//1024}K'\n101\t        s.append(f'<line x1=\"{x:.1f}\" y1=\"{mt}\" x2=\"{x:.1f}\" y2=\"{mt+ph}\" class=\"grid vg\"/>')\n102\t        s.append(f'<text x=\"{x:.1f}\" y=\"{mt+ph+16}\" class=\"cxt\">{lab}</text>')\n103\t    for im in impls:\n104\t        cs=sorted(series[im])\n105\t        if not cs: continue\n106\t        if band and im in band:\n107\t            up=\" \".join(f\"{X(c):.1f},{Y(band[im][c][1]):.1f}\" for c in cs if c in band[im])\n108\t            dn=\" \".join(f\"{X(c):.1f},{Y(band[im][c][0]):.1f}\" for c in reversed(cs) if c in band[im])\n109\t            if up: s.append(f'<polygon points=\"{up} {dn}\" fill=\"{COLOR[im]}\" opacity=\"0.09\"/>')\n110\t        path=\" \".join(((\"M\" if i==0 else \"L\")+f\"{X(c):.1f},{Y(series[im][c]):.1f}\") for i,c in enumerate(cs))\n111\t        s.append(f'<path d=\"{path}\" fill=\"none\" stroke=\"{COLOR[im]}\" stroke-width=\"2.4\"/>')\n112\t        for c in cs: s.append(f'<circle cx=\"{X(c):.1f}\" cy=\"{Y(series[im][c]):.1f}\" r=\"3\" fill=\"{COLOR[im]}\"/>')\n113\t        bc=min(cs,key=lambda k:series[im][k])\n114\t        s.append(f'<circle cx=\"{X(bc):.1f}\" cy=\"{Y(series[im][bc]):.1f}\" r=\"6\" fill=\"none\" stroke=\"{COLOR[im]}\" stroke-width=\"2\"/>')\n115\t    if oom:\n116\t        for im,cc in oom.items():\n117\t            s.append(f'<text x=\"{X(FULL):.1f}\" y=\"{mt+13}\" class=\"oom\">{im} ✕ OOM</text>')\n118\t    s.append('</svg>')\n119\t    return f'<figure class=\"cf\"><figcaption>{sub}</figcaption>{\"\".join(s)}</figure>'\n120\t\n121\tgpu_t={im:{c:v[0] for c,v in GPU[im].items()} for im in IMPLS}\n122\tgpu_v={im:{c:v[1] for c,v in GPU[im].items()} for im in IMPLS}\n123\tc_gt=chart(gpu_t,GPU_BAND,\"fit time (s, log)\",True,\"GPU · fit time vs chunk\",\"real ds004505 · H100 · 100 iters · 25-subject median · band = min–max\",IMPLS,oom={\"scott\":\"full\"})\n124\tc_gv=chart(gpu_v,None,\"peak VRAM (GB)\",False,\"GPU · memory vs chunk\",\"real ds004505 · H100 · median peak VRAM · full-batch is the trap\",IMPLS)\n125\tCPU_IMPLS=[\"jamica\",\"pamica\",\"pyamica\",\"scott\",\"fortran\"]\n126\tc_cr=chart(CPU_RSS,None,\"peak RSS (GB)\",False,\"CPU · memory vs chunk\",\"real ds004505 · 8 cores · 5-subject median · Fortran reference is leanest\",CPU_IMPLS)\n127\tc_ct=chart(CPU_FIT,None,\"fit time (s, log)\",True,\"CPU · fit time vs chunk\",\"real ds004505 · 8 cores · best-of-5 subjects (≈ least-contended) · optimum flips to small/mid chunks\",CPU_IMPLS,oom={\"scott\":\"full\"})\n128\t\n129\tdef legend(impls):\n130\t    it=\"\".join(f'<span class=\"lg\"><i style=\"background:{COLOR[i]}\"></i>{LABEL.get(i,\"Fortran amica17\")} <code>{KNOB[i]}</code> <span class=\"cm\">@{COMMIT[i]}</span></span>' for i in impls)\n131\t    return f'<div class=\"legend\">{it}<span class=\"lg\">◯ each impl\\'s optimum</span></div>'\n132\t\n133\tdef optrows():\n134\t    base=REAL_OPT[0][2]; r=\"\"\n135\t    for im,cfg,t,vram in REAL_OPT:\n136\t        cls=' class=\"hi\"' if im==\"jamica\" else \"\"\n137\t        r+=f'<tr{cls}><td><span class=\"dot\" style=\"background:{COLOR[im]}\"></span>{LABEL[im]}</td><td><code>{cfg}</code></td><td class=\"num\">{t:.1f}s</td><td class=\"num\">{t/base:.1f}×</td><td class=\"num\">{vram:.1f} GB</td></tr>'\n138\t    return r\n139\tdef pamrows():\n140\t    bd={\"artifact\":'<span class=\"badge bad\">config artifact</span>',\"tuned\":'<span class=\"badge ok\">tuned</span>',\"best\":'<span class=\"badge best\">best</span>'}\n141\t    return \"\".join(f'<tr><td><code>{cfg}</code></td><td class=\"num\">{t:.1f}s</td><td class=\"num\">{v:.2f} GB</td><td>{bd[tag]}</td></tr>' for cfg,t,v,tag in REAL_PAM)\n142\tdef cpufitrows():\n143\t    r=\"\"\n144\t    for im in CPU_IMPLS:\n145\t        cells=\"\"\n146\t        for c in XT:\n147\t            if c in CPU_FIT[im]:\n148\t                cells+=f'<td class=\"num\">{CPU_FIT[im][c]:.0f}s</td>'\n149\t            elif (im,c) in CPU_FIT_MISS:\n150\t                lab,cls=CPU_FIT_MISS[(im,c)]\n151\t                cells+=f'<td class=\"num\"><span class=\"badge {cls}\">{lab}</span></td>'\n152\t            else:\n153\t                cells+='<td class=\"num\">—</td>'\n154\t        r+=f'<tr><td><span class=\"dot\" style=\"background:{COLOR[im]}\"></span>{LABEL.get(im,\"Fortran amica17\")}</td>{cells}</tr>'\n155\t    return r\n156\t\n157\tHTML=f\"\"\"<title>AMICA benchmark — chunk size is the hidden variable (real data)</title>\n158\t<style>\n159\t:root{{--bg:#f7f8fb;--panel:#fff;--ink:#1a1d29;--mut:#5b6172;--line:#e3e6ef;--accent:#6366f1;--good:#0d9488;--bad:#e11d48;--warn:#d97706;--code:#eef0f7;--shadow:0 1px 2px rgba(20,24,45,.05),0 8px 24px rgba(20,24,45,.05)}}\n160\t@media(prefers-color-scheme:dark){{:root{{--bg:#0e1017;--panel:#161a24;--ink:#e7e9f2;--mut:#9aa0b4;--line:#262c3a;--accent:#8b8ff5;--code:#1d2230;--shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.35)}}}}\n161\t:root[data-theme=dark]{{--bg:#0e1017;--panel:#161a24;--ink:#e7e9f2;--mut:#9aa0b4;--line:#262c3a;--accent:#8b8ff5;--code:#1d2230;--shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.35)}}\n162\t:root[data-theme=light]{{--bg:#f7f8fb;--panel:#fff;--ink:#1a1d29;--mut:#5b6172;--line:#e3e6ef;--accent:#6366f1;--code:#eef0f7;--shadow:0 1px 2px rgba(20,24,45,.05),0 8px 24px rgba(20,24,45,.05)}}\n163\t*{{box-sizing:border-box}}body{{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}}\n164\t.wrap{{max-width:1080px;margin:0 auto;padding:0 24px 96px}}\n165\tcode{{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.85em;background:var(--code);padding:.06em .4em;border-radius:5px}}\n166\t.num{{font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}}\n167\theader.hero{{padding:60px 0 28px;border-bottom:1px solid var(--line)}}\n168\t.kick{{font-size:.72rem;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:700}}\n169\th1{{font-size:clamp(2rem,4.4vw,3rem);line-height:1.05;letter-spacing:-.02em;margin:.28em 0 .3em;text-wrap:balance;font-weight:800}}\n170\th1 em{{font-style:normal;color:var(--accent)}}\n171\t.lede{{font-size:1.14rem;color:var(--mut);max-width:66ch;margin:0}}\n172\t.stamp{{display:inline-flex;flex-wrap:wrap;gap:6px 14px;margin:16px 0 0;padding:10px 14px;background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:10px;font-size:.83rem}}\n173\t.stamp b{{color:var(--accent)}}\n174\tsection{{padding:44px 0 6px;border-bottom:1px solid var(--line)}}\n175\th2{{font-size:1.5rem;letter-spacing:-.01em;margin:0 0 4px;font-weight:750}}\n176\t.sub{{color:var(--mut);margin:.1em 0 1.3em;max-width:68ch}}\n177\t.grid2{{display:grid;grid-template-columns:1fr 1fr;gap:20px}}@media(max-width:760px){{.grid2{{grid-template-columns:1fr}}}}\n178\t.card{{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:12px 12px 4px}}\n179\t.cf{{margin:0}}.cf figcaption{{font-size:.82rem;color:var(--mut);padding:3px 5px 8px}}\n180\tsvg.chart{{width:100%;height:auto;display:block;overflow:visible}}\n181\t.chart .grid{{stroke:var(--line)}}.chart .vg{{stroke-dasharray:2 3;opacity:.7}}\n182\t.chart .ct{{fill:var(--ink);font:700 13px ui-sans-serif}}.chart .cx,.chart .cy{{fill:var(--mut);font:11px ui-sans-serif}}\n183\t.chart .cyt,.chart .cxt{{fill:var(--mut);font:10px ui-monospace,monospace}}.chart .cyt{{text-anchor:end}}.chart .cxt{{text-anchor:middle}}\n184\t.chart .oom{{fill:#e11d48;font:600 10px ui-sans-serif;text-anchor:middle}}\n185\t.legend{{display:flex;flex-wrap:wrap;gap:8px 18px;margin:14px 2px 2px;font-size:.82rem;color:var(--mut);align-items:center}}\n186\t.lg{{display:inline-flex;align-items:center;gap:6px}}.lg i{{width:15px;height:3px;border-radius:2px}}.cm{{font-family:ui-monospace,monospace;font-size:.78em;opacity:.7}}\n187\ttable{{width:100%;border-collapse:collapse;font-size:.95rem;margin:.2em 0 1em}}\n188\tth,td{{text-align:left;padding:9px 12px;border-bottom:1px solid var(--line)}}\n189\tth{{font-size:.74rem;letter-spacing:.05em;text-transform:uppercase;color:var(--mut);font-weight:650}}\n190\ttr.hi td{{background:color-mix(in srgb,var(--accent) 9%,transparent)}}tbody tr:last-child td{{border-bottom:none}}\n191\t.dot{{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:8px;vertical-align:middle}}\n192\t.badge{{font-size:.72rem;padding:2px 9px;border-radius:20px;font-weight:600;white-space:nowrap}}\n193\t.badge.bad{{background:color-mix(in srgb,var(--bad) 16%,transparent);color:var(--bad)}}.badge.ok{{background:color-mix(in srgb,var(--warn) 18%,transparent);color:var(--warn)}}.badge.best{{background:color-mix(in srgb,var(--good) 16%,transparent);color:var(--good)}}\n194\t.callout{{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:8px 0 20px}}@media(max-width:720px){{.callout{{grid-template-columns:1fr}}}}\n195\t.stat{{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px;box-shadow:var(--shadow)}}\n196\t.stat .big{{font-size:1.9rem;font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1}}\n197\t.stat .lab{{color:var(--mut);font-size:.86rem;margin-top:6px}}\n198\t.stat.jamica .big{{color:var(--accent)}}.stat.bad .big{{color:var(--bad)}}.stat.warn .big{{color:var(--warn)}}\n199\tp{{max-width:68ch}}.note{{font-size:.9rem;color:var(--mut)}}\n200\t.warn-box{{background:color-mix(in srgb,var(--warn) 8%,var(--panel));border:1px solid var(--line);border-left:3px solid var(--warn);border-radius:10px;padding:14px 18px;margin:6px 0 14px;font-size:.92rem}}\n201\tul.tk{{max-width:68ch;padding-left:0;list-style:none}}ul.tk li{{padding:7px 0 7px 24px;position:relative;border-bottom:1px solid var(--line)}}\n202\tul.tk li:before{{content:\"\";position:absolute;left:3px;top:14px;width:8px;height:8px;border-radius:50%;background:var(--accent)}}\n203\t.quote{{border-left:3px solid var(--accent);padding:4px 0 4px 16px;margin:14px 0;color:var(--mut);font-style:italic;max-width:68ch}}\n204\tfooter{{padding:34px 0 0;color:var(--mut);font-size:.86rem}}\n205\t.prov{{display:grid;grid-template-columns:150px 1fr;gap:4px 16px;font-size:.9rem;margin-top:8px}}.prov dt{{color:var(--mut)}}.prov dd{{margin:0;font-family:ui-monospace,monospace;font-size:.86em}}\n206\t</style>\n207\t<div class=\"wrap\">\n208\t<header class=\"hero\">\n209\t  <div class=\"kick\">Cross-implementation AMICA · ds004505 · real EEG · bleeding-edge</div>\n210\t  <h1>Chunk size is the <em>hidden variable</em></h1>\n211\t  <p class=\"lede\">On real EEG, the batching knob moves fit time up to ~30× and peak memory up to ~30×.\n212\t  Every implementation is strongly chunk-sensitive; the defaults are footguns. jamica is fastest\n213\t  at every chunk and leanest at full-batch.</p>\n214\t  <div class=\"stamp\"><span><b>Latest main:</b></span><span>jamica <code>df18b5e</code></span><span>scott <code>e15e158</code></span><span>pyamica <code>a8a4d7e</code></span><span>pAMICA <code>0c4da39</code></span><span>Fortran ref <code>665b577</code></span><span>· 25 subj · 64 comp · 100 iters · H100 + 8-core Xeon</span></div>\n215\t</header>\n216\t\n217\t<section>\n218\t  <h2>The correction that motivated this</h2>\n219\t  <p class=\"sub\">A naive comparison uses each library's default batching. pAMICA's default\n220\t  (<code>block_size=512</code>) alone produced a ~15–47× \"gap\" that is a configuration artifact, not an\n221\t  algorithmic one — on the same real subjects, the same pAMICA:</p>\n222\t  <div class=\"callout\">\n223\t    <div class=\"stat bad\"><div class=\"big\">140→9.2s</div><div class=\"lab\">pAMICA on ds004505 (GPU median) from its 512 default to full-batch — a 15× self-speedup from one number.</div></div>\n224\t    <div class=\"stat warn\"><div class=\"big\">~30×</div><div class=\"lab\">Range of every library across the chunk axis on real data. The default is never the optimum, and the optimum flips by device.</div></div>\n225\t    <div class=\"stat jamica\"><div class=\"big\">1.8×</div><div class=\"lab\">jamica's real lead over pAMICA when both run at their own optimum — not tens of ×.</div></div>\n226\t  </div>\n227\t  <table><thead><tr><th><code>block_size</code></th><th>Fit time</th><th>Peak VRAM</th><th></th></tr></thead><tbody>{pamrows()}</tbody></table>\n228\t  <p class=\"note\">pAMICA's torch backend does not auto-tune <code>block_size</code>; reporting its\n229\t  shipped default as \"pAMICA performance\" is what produced the headline gap.</p>\n230\t</section>\n231\t\n232\t<section>\n233\t  <h2>Real GPU curves — fit time &amp; memory</h2>\n234\t  <p class=\"sub\">Every implementation swept across its batching knob on real ds004505 (25-subject\n235\t  median, 100 iterations, H100, latest main). ◯ = each impl's optimum; shaded band = min–max across\n236\t  subjects (the wide small-chunk tails are compile/scheduling variance).</p>\n237\t  <div class=\"grid2\"><div class=\"card\">{c_gt}</div><div class=\"card\">{c_gv}</div></div>\n238\t  {legend(IMPLS)}\n239\t  <ul class=\"tk\" style=\"margin-top:20px\">\n240\t    <li><b>jamica is fastest at every chunk</b> — and its curve is a normal, steep U on real\n241\t    data (29→5 s), <em>not</em> flat (see methodology below).</li>\n242\t    <li><b>Defaults are footguns.</b> Small blocks are catastrophic (scott/pAMICA 140–170 s at 1024);\n243\t    the optimum is per-library and only found by sweeping.</li>\n244\t    <li><b>Full-batch is a memory trap:</b> pyamica <b>28 GB</b> / pAMICA <b>19 GB</b>, and\n245\t    scott-huberty <b>OOMs</b> — while jamica reaches its best time in ~8 GB (≈2 GB when chunked).</li>\n246\t  </ul>\n247\t</section>\n248\t\n249\t<section>\n250\t  <h2>Fair comparison — each at its own optimum</h2>\n251\t  <p class=\"sub\">The authoritative ranking: real ds004505, 25-subject median, every library at\n252\t  <em>its</em> best chunk on the H100.</p>\n253\t  <table><thead><tr><th>Implementation</th><th>Batching</th><th>Fit time</th><th>vs jamica</th><th>Peak VRAM</th></tr></thead><tbody>{optrows()}</tbody></table>\n254\t  <p class=\"note\">jamica leads by <b>1.8×</b> over pAMICA at optima — not the tens-of-× a default\n255\t  comparison implies. jamica also pays the least memory for its speed.</p>\n256\t</section>\n257\t\n258\t<section>\n259\t  <h2>CPU — fit time &amp; memory</h2>\n260\t  <p class=\"sub\">Real ds004505, 8 cores, 5 subjects (fair-share-neutral throttled rerun). Fit-time is\n261\t  the <b>best-of-5 per cell</b> — a least-contended lower bound; memory is allocation-driven, so clean\n262\t  regardless. ◯ = each impl's CPU optimum. Includes the Fortran amica17 reference (CPU-only).</p>\n263\t  <div class=\"grid2\"><div class=\"card\">{c_ct}</div><div class=\"card\">{c_cr}</div></div>\n264\t  {legend(CPU_IMPLS)}\n265\t  <ul class=\"tk\" style=\"margin-top:20px\">\n266\t    <li><b>The optimum flips by device.</b> CPU optima sit at <em>small/mid</em> chunks (jamica 1024,\n267\t    scott/Fortran ~4096, pyamica 16384) — the opposite of the GPU, where full-batch won. Small blocks\n268\t    fit CPU cache; on the H100 they starve the device. A single recommended chunk is wrong.</li>\n269\t    <li><b>jamica is fastest on CPU too</b> — best ~155 s vs scott 164, pAMICA 241, Fortran 589, pyamica 724.</li>\n270\t    <li><b>Full-batch is a memory trap on CPU as well</b> (jamica 21 GB, pyamica 27 GB); the Fortran\n271\t    reference is the leanest everywhere (0.7 GB).</li>\n272\t    <li><b>Extremes fail:</b> pyamica@1024 exceeds the 1-hour runner timeout (~767 eager chunks/iter);\n273\t    scott full-batch OOMs — both absent from the curve.</li>\n274\t  </ul>\n275\t  <div class=\"warn-box\" style=\"margin-top:14px\"><b>Why best-of-5, not the mean.</b> CPU cells ran on\n276\t  shared <code>bycore</code> nodes; AMICA fits are memory-bandwidth-bound, so co-located cells starve\n277\t  each other. Even the throttled rerun (job array, <code>%4</code>) leaves residual contention, and the\n278\t  5 subjects differ in length — so the per-cell <em>median</em> stays non-monotonic. The <em>min</em>\n279\t  across subjects recovers the clean chunk trend. Absolute CPU seconds are approximate; trust the shapes\n280\t  and ordering. Full analysis + noise estimate: <code>NOTES_measurement.md</code>.</div>\n281\t</section>\n282\t\n283\t<section>\n284\t  <h2>Methodology — why the synthetic \"flat curve\" was a mirage</h2>\n285\t  <p class=\"sub\">An earlier synthetic microbenchmark (random data, 20 iters) showed jamica with a\n286\t  suspiciously flat GPU curve. An independent panel (GPT-5.6 + Grok-4.6) and a steady-state\n287\t  re-measurement traced it to a <b>JIT-compile artifact</b>, not robustness.</p>\n288\t  <p>With <code>chunk_size</code> a JIT static argument, each of jamica's fused-scan cells compiled a\n289\t  different program; a fresh-process 20-iter wall clock folds a ~2.5 s compile into every point, which\n290\t  flattens a short run. Splitting compile from steady-state ms/iter (<code>(T₄₀−T₁₀)/30</code>) reveals\n291\t  a normal <b>~19× steady-state spread</b> — jamica is <em>not</em> chunk-robust. The real 100-iteration\n292\t  workload above confirms it: a steep, ordinary U-curve. What jamica genuinely has is a fused in-graph\n293\t  blocked E-step (no Python-per-block penalty), memory-efficient full-batch, a correct <code>auto</code>\n294\t  pick per device, and the fastest real-workload time — not knob-insensitivity.</p>\n295\t  <div class=\"quote\">\"Flattest ⇒ most robust is a self-serving reading of a short, compile-contaminated\n296\t  GPU sweep.\" — adversarial panel synthesis</div>\n297\t</section>\n298\t\n299\t<section>\n300\t  <h2>Release vs main</h2>\n301\t  <p class=\"sub\">All curves above are latest <code>main</code>. Release→main is performance-neutral on\n302\t  GPU (measured identical); jamica's one perf-relevant commit (<code>2cd81e4</code>, \"make CPU fits\n303\t  faster and smaller\") touches the CPU E-step only. Competitor <code>main</code> builds move only\n304\t  through the same batching knob; bumping to main rescues no one's default (pAMICA <code>main</code> is\n305\t  still 140 s at 512). The CPU curves above are the clean throttled <code>main</code> build; a\n306\t  like-for-like release-vs-main CPU comparison at clean concurrency was out of scope for this pass.</p>\n307\t</section>\n308\t\n309\t<footer>\n310\t  <div class=\"kick\" style=\"color:var(--mut)\">Provenance &amp; reproduction</div>\n311\t  <dl class=\"prov\">\n312\t    <dt>Dataset</dt><dd>ds004505 · 25 subjects (GPU) / 5 (CPU) · 64 PCA components</dd>\n313\t    <dt>GPU</dt><dd>NVIDIA H100 80GB · SciNet Trillium (def-kjerbi)</dd>\n314\t    <dt>CPU</dt><dd>8 cores · Alliance fir (rrg-kjerbi_cpu, bycore)</dd>\n315\t    <dt>Commits</dt><dd>jamica df18b5e · scott e15e158 · pyamica a8a4d7e · pAMICA 0c4da39 · Fortran 665b577</dd>\n316\t    <dt>Workload</dt><dd>64 comp · 100 iters · per-subject median</dd>\n317\t    <dt>Runners</dt><dd>results/xperf_chunksize/sweeps/ + submit_cell_cpu.sh (atomic cells, cached input)</dd>\n318\t    <dt>Panel</dt><dd>panel/ (GPT-5.6 + Grok-4.6 + SYNTHESIS)</dd>\n319\t    <dt>Caveats</dt><dd>NOTES_measurement.md (CPU contention + noise estimate)</dd>\n320\t  </dl>\n321\t  <p class=\"note\" style=\"margin-top:16px\">Trust the shapes, the ordering, and each implementation's\n322\t  optimum. GPU absolutes are 25-subject medians; CPU <em>memory</em> is clean; CPU <em>fit-times</em>\n323\t  are best-of-5 (least-contended) from the throttled rerun — approximate absolutes, clean trend.</p>\n324\t</footer>\n325\t</div>\"\"\"\n326\tHERE=os.path.dirname(os.path.abspath(__file__))\n327\t# content version (no <!doctype>/<head>/<body> — the Artifact publish step adds those)\n328\topen(os.path.join(HERE,\"xperf_chunk_report.html\"),\"w\").write(HTML)\n329\t# standalone version — full document, opens directly in any browser\n330\t_title = HTML.split(\"<title>\",1)[1].split(\"</title>\",1)[0] if \"<title>\" in HTML else \"AMICA chunk-size report\"\n331\tSTANDALONE = ('<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">'\n332\t              '<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">'\n333\t              f'<title>{_title}</title></head><body>\\n{HTML}\\n</body></html>\\n')\n334\topen(os.path.join(HERE,\"xperf_chunk_report_standalone.html\"),\"w\").write(STANDALONE)\n335\tprint(\"wrote real-data report\", len(HTML), \"bytes (+ standalone\", len(STANDALONE), \"bytes)\")\n336\t"}]},"parent_tool_use_id":null,"session_id":"4432191b-ac87-4500-8cd4-5ad89611f7a7","uuid":"bbcf4a17-1345-41c7-9b98-fd6f8e6dd80c","timestamp":"2026-08-13T16:02:57.457Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tmp.3Rd3HvEgNr/benchmark/comparator/results/xperf_chunksize/gen_report.py","content":"#!/usr/bin/env python3\n\"\"\"Render the chunk-size study report (self-contained HTML) — REAL-data primary (bleeding-edge).\n\nThesis: chunk size is the dominant performance variable; every implementation is strongly\nchunk-sensitive; defaults are footguns. On the real ds004505 workload (25-subject median, H100,\nlatest main) jamica is fastest at every chunk and leanest at full-batch. The synthetic\n\"flat curve\" that once looked like robustness was a JIT-compile artifact (methodology section).\nCPU absolute timings carry a node-contention caveat (see NOTES_measurement.md); CPU *memory* is clean.\n\"\"\"\nimport math, os\n\nFULL = 262144\nIMPLS = [\"jamica\", \"pamica\", \"pyamica\", \"scott\"]\nLABEL = {\"jamica\":\"jamica\",\"pamica\":\"pAMICA (sccn)\",\"pyamica\":\"pyamica\",\"scott\":\"scott-huberty\"}\nKNOB  = {\"jamica\":\"chunk_size\",\"pamica\":\"block_size\",\"pyamica\":\"chunk_t\",\"scott\":\"batch_size\",\"fortran\":\"block_size\"}\nCOMMIT= {\"jamica\":\"df18b5e\",\"pamica\":\"0c4da39\",\"pyamica\":\"a8a4d7e\",\"scott\":\"e15e158\",\"fortran\":\"665b577\"}\nCOLOR = {\"jamica\":\"#6366f1\",\"pamica\":\"#d97706\",\"pyamica\":\"#0d9488\",\"scott\":\"#e11d48\",\"fortran\":\"#7c3aed\"}\n\n# ===== REAL ds004505, latest main, 25-subject median (GPU) : chunk -> (fit_s, vram_gb) =====\nGPU = {\n \"jamica\":   {1024:(29.2,2.19),4096:(11.0,2.19),16384:(6.8,2.19),65536:(5.6,3.68),FULL:(5.2,8.14)},\n \"pamica\":  {1024:(139.6,0.58),4096:(36.9,0.64),16384:(14.3,0.86),65536:(11.6,1.75),FULL:(9.2,19.25)},\n \"pyamica\": {1024:(81.3,1.66),4096:(21.1,1.66),16384:(12.7,1.66),65536:(11.7,3.07),FULL:(9.7,28.30)},\n \"scott\":   {1024:(172.4,0.58),4096:(45.2,0.62),16384:(15.4,0.77),65536:(10.1,1.38)},  # full = OOM\n}\nGPU_OOM = {\"scott\": \"full\"}\n# fit-time spread (min,max) across 25 subjects, for the band\nGPU_BAND = {\n \"jamica\":   {1024:(20.8,34.7),4096:(9.1,29.9),16384:(6.0,43.0),65536:(5.0,10.5),FULL:(4.1,30.5)},\n \"pamica\":  {1024:(99.2,170.4),4096:(29.2,49.8),16384:(11.6,40.6),65536:(8.2,34.5),FULL:(7.0,33.5)},\n \"pyamica\": {1024:(58.5,98.8),4096:(15.0,26.2),16384:(9.4,15.8),65536:(8.4,14.3),FULL:(7.0,12.1)},\n \"scott\":   {1024:(123.3,213.5),4096:(36.8,72.4),16384:(13.3,85.7),65536:(7.4,16.8)},\n}\n# ===== REAL CPU memory (peak RSS, GB), 5-subject median : chunk -> rss (timing is contended, see note) =====\nCPU_RSS = {\n \"jamica\":   {1024:2.23,4096:2.27,16384:2.23,65536:3.68,FULL:20.62},\n \"pamica\":  {1024:1.58,4096:1.74,16384:2.36,65536:2.63,FULL:19.57},\n \"pyamica\": {4096:1.94,16384:2.75,65536:3.81,FULL:27.21},\n \"scott\":   {1024:2.06,4096:2.06,16384:2.06,65536:2.31},\n \"fortran\": {1024:0.72,4096:0.75,16384:0.86,65536:1.32,FULL:9.97},\n}\n# REAL CPU fit-time (s), throttled %4 rerun, 5 subjects. CPU_FIT = min across subjects\n# (best observed ≈ least-contended, the clean lower-bound curve); CPU_FIT_MED = median (still\n# carries residual node contention + per-subject data-size heterogeneity, shown for context).\nCPU_FIT = {  # min across subjects — the clean curve\n \"jamica\":   {1024:155.0,4096:156.5,16384:162.3,65536:181.6,FULL:288.3},\n \"scott\":   {1024:195.0,4096:164.5,16384:172.3,65536:235.5},\n \"pyamica\": {4096:2008.4,16384:724.2,65536:776.9,FULL:903.2},\n \"pamica\":  {1024:241.3,4096:261.0,16384:341.7,65536:833.0,FULL:754.2},\n \"fortran\": {1024:639.8,4096:589.5,16384:730.3,65536:764.3,FULL:790.9},\n}\nCPU_FIT_MED = {  # median (contention-noisy, context only)\n \"jamica\":{1024:276.4,4096:220.9,16384:186.6,65536:255.7,FULL:398.8},\n \"scott\":{1024:257.9,4096:290.7,16384:268.9,65536:321.4},\n \"pyamica\":{4096:2345.0,16384:969.9,65536:980.8,FULL:980.7},\n \"pamica\":{1024:534.9,4096:431.3,16384:408.7,65536:911.7,FULL:815.8},\n \"fortran\":{1024:759.7,4096:812.4,16384:845.0,65536:862.8,FULL:960.9},\n}\n# Why a CPU cell has no number (not just \"missing\"):\nCPU_FIT_MISS = {(\"pyamica\",1024):(\"&gt;1h\",\"bad\"),   # exceeded the 3600s runner timeout (pathological small-block)\n                (\"scott\",FULL):(\"OOM\",\"bad\")}         # full-batch out-of-memory (~30s failure)\n# Real each-at-own-optimum on GPU (25-subj median), fit + vram\nREAL_OPT = [(\"jamica\",\"full-batch\",5.2,8.1),(\"pamica\",\"full-batch\",9.2,19.3),\n            (\"pyamica\",\"full-batch\",9.7,28.3),(\"scott\",\"65536\",10.1,1.4)]\n# pAMICA default sensitivity (the 47x), GPU 25-subj median\nREAL_PAM = [(\"512 (default)\",139.6,0.58,\"artifact\"),(\"16384 (tuned)\",14.3,0.86,\"tuned\"),\n            (\"full-batch (best)\",9.2,19.25,\"best\")]\n\ndef xlog(c): return math.log2(FULL*4 if c==FULL else c)\nXT=[1024,4096,16384,65536,FULL]; XMIN,XMAX=math.log2(1024)-0.4,xlog(FULL)+0.4\n\ndef chart(series, band, ylab, ylog, title, sub, impls, oom=None):\n    W,H=520,340; ml,mr,mt,mb=56,14,32,52; pw,ph=W-ml-mr,H-mt-mb\n    def X(c): return ml+(xlog(c)-XMIN)/(XMAX-XMIN)*pw\n    allv=[v for im in impls for v in series[im].values()]\n    if band: allv+=[b for im in impls for c in series[im] if im in band and c in band[im] for b in band[im][c]]\n    vmax=max(allv); vmin=min(v for v in allv if v>0)\n    if ylog:\n        lo,hi=math.log10(vmin*0.8),math.log10(vmax*1.25)\n        def Y(v): return mt+ph-(math.log10(max(v,vmin*0.5))-lo)/(hi-lo)*ph\n    else:\n        hi=vmax*1.12; lo=0\n        def Y(v): return mt+ph-(v-lo)/(hi-lo)*ph\n    s=[f'<svg viewBox=\"0 0 {W} {H}\" class=\"chart\" role=\"img\" aria-label=\"{title}\">']\n    s.append(f'<text x=\"{ml}\" y=\"16\" class=\"ct\">{title}</text>')\n    s.append(f'<text x=\"{ml}\" y=\"{H-6}\" class=\"cx\">chunk / block size (samples) →</text>')\n    s.append(f'<text transform=\"translate(14,{mt+ph/2}) rotate(-90)\" class=\"cy\">{ylab}</text>')\n    if ylog:\n        ticks=[]; d0=1\n        while d0<=vmax*1.25:\n            for m0 in (1,2,5):\n                if vmin*0.7<=d0*m0<=vmax*1.25: ticks.append(d0*m0)\n            d0*=10\n    else: ticks=[hi*i/4 for i in range(5)]\n    for t in ticks:\n        y=Y(t); s.append(f'<line x1=\"{ml}\" y1=\"{y:.1f}\" x2=\"{W-mr}\" y2=\"{y:.1f}\" class=\"grid\"/>')\n        lab=f'{t:.0f}' if t>=1 else f'{t:.1f}'\n        s.append(f'<text x=\"{ml-6}\" y=\"{y+3:.1f}\" class=\"cyt\">{lab}</text>')\n    for c in XT:\n        x=X(c); lab=\"full\" if c==FULL else f'{c//1024}K'\n        s.append(f'<line x1=\"{x:.1f}\" y1=\"{mt}\" x2=\"{x:.1f}\" y2=\"{mt+ph}\" class=\"grid vg\"/>')\n        s.append(f'<text x=\"{x:.1f}\" y=\"{mt+ph+16}\" class=\"cxt\">{lab}</text>')\n    for im in impls:\n        cs=sorted(series[im])\n        if not cs: continue\n        if band and im in band:\n            up=\" \".join(f\"{X(c):.1f},{Y(band[im][c][1]):.1f}\" for c in cs if c in band[im])\n            dn=\" \".join(f\"{X(c):.1f},{Y(band[im][c][0]):.1f}\" for c in reversed(cs) if c in band[im])\n            if up: s.append(f'<polygon points=\"{up} {dn}\" fill=\"{COLOR[im]}\" opacity=\"0.09\"/>')\n        path=\" \".join(((\"M\" if i==0 else \"L\")+f\"{X(c):.1f},{Y(series[im][c]):.1f}\") for i,c in enumerate(cs))\n        s.append(f'<path d=\"{path}\" fill=\"none\" stroke=\"{COLOR[im]}\" stroke-width=\"2.4\"/>')\n        for c in cs: s.append(f'<circle cx=\"{X(c):.1f}\" cy=\"{Y(series[im][c]):.1f}\" r=\"3\" fill=\"{COLOR[im]}\"/>')\n        bc=min(cs,key=lambda k:series[im][k])\n        s.append(f'<circle cx=\"{X(bc):.1f}\" cy=\"{Y(series[im][bc]):.1f}\" r=\"6\" fill=\"none\" stroke=\"{COLOR[im]}\" stroke-width=\"2\"/>')\n    if oom:\n        for im,cc in oom.items():\n            s.append(f'<text x=\"{X(FULL):.1f}\" y=\"{mt+13}\" class=\"oom\">{im} ✕ OOM</text>')\n    s.append('</svg>')\n    return f'<figure class=\"cf\"><figcaption>{sub}</figcaption>{\"\".join(s)}</figure>'\n\ngpu_t={im:{c:v[0] for c,v in GPU[im].items()} for im in IMPLS}\ngpu_v={im:{c:v[1] for c,v in GPU[im].items()} for im in IMPLS}\nc_gt=chart(gpu_t,GPU_BAND,\"fit time (s, log)\",True,\"GPU · fit time vs chunk\",\"real ds004505 · H100 · 100 iters · 25-subject median · band = min–max\",IMPLS,oom={\"scott\":\"full\"})\nc_gv=chart(gpu_v,None,\"peak VRAM (GB)\",False,\"GPU · memory vs chunk\",\"real ds004505 · H100 · median peak VRAM · full-batch is the trap\",IMPLS)\nCPU_IMPLS=[\"jamica\",\"pamica\",\"pyamica\",\"scott\",\"fortran\"]\nc_cr=chart(CPU_RSS,None,\"peak RSS (GB)\",False,\"CPU · memory vs chunk\",\"real ds004505 · 8 cores · 5-subject median · Fortran reference is leanest\",CPU_IMPLS)\nc_ct=chart(CPU_FIT,None,\"fit time (s, log)\",True,\"CPU · fit time vs chunk\",\"real ds004505 · 8 cores · best-of-5 subjects (≈ least-contended) · optimum flips to small/mid chunks\",CPU_IMPLS,oom={\"scott\":\"full\"})\n\ndef legend(impls):\n    it=\"\".join(f'<span class=\"lg\"><i style=\"background:{COLOR[i]}\"></i>{LABEL.get(i,\"Fortran amica17\")} <code>{KNOB[i]}</code> <span class=\"cm\">@{COMMIT[i]}</span></span>' for i in impls)\n    return f'<div class=\"legend\">{it}<span class=\"lg\">◯ each impl\\'s optimum</span></div>'\n\ndef optrows():\n    base=REAL_OPT[0][2]; r=\"\"\n    for im,cfg,t,vram in REAL_OPT:\n        cls=' class=\"hi\"' if im==\"jamica\" else \"\"\n        r+=f'<tr{cls}><td><span class=\"dot\" style=\"background:{COLOR[im]}\"></span>{LABEL[im]}</td><td><code>{cfg}</code></td><td class=\"num\">{t:.1f}s</td><td class=\"num\">{t/base:.1f}×</td><td class=\"num\">{vram:.1f} GB</td></tr>'\n    return r\ndef pamrows():\n    bd={\"artifact\":'<span class=\"badge bad\">config artifact</span>',\"tuned\":'<span class=\"badge ok\">tuned</span>',\"best\":'<span class=\"badge best\">best</span>'}\n    return \"\".join(f'<tr><td><code>{cfg}</code></td><td class=\"num\">{t:.1f}s</td><td class=\"num\">{v:.2f} GB</td><td>{bd[tag]}</td></tr>' for cfg,t,v,tag in REAL_PAM)\ndef cpufitrows():\n    r=\"\"\n    for im in CPU_IMPLS:\n        cells=\"\"\n        for c in XT:\n            if c in CPU_FIT[im]:\n                cells+=f'<td class=\"num\">{CPU_FIT[im][c]:.0f}s</td>'\n            elif (im,c) in CPU_FIT_MISS:\n                lab,cls=CPU_FIT_MISS[(im,c)]\n                cells+=f'<td class=\"num\"><span class=\"badge {cls}\">{lab}</span></td>'\n            else:\n                cells+='<td class=\"num\">—</td>'\n        r+=f'<tr><td><span class=\"dot\" style=\"background:{COLOR[im]}\"></span>{LABEL.get(im,\"Fortran amica17\")}</td>{cells}</tr>'\n    return r\n\nHTML=f\"\"\"<title>AMICA benchmark — chunk size is the hidden variable (real data)</title>\n<style>\n:root{{--bg:#f7f8fb;--panel:#fff;--ink:#1a1d29;--mut:#5b6172;--line:#e3e6ef;--accent:#6366f1;--good:#0d9488;--bad:#e11d48;--warn:#d97706;--code:#eef0f7;--shadow:0 1px 2px rgba(20,24,45,.05),0 8px 24px rgba(20,24,45,.05)}}\n@media(prefers-color-scheme:dark){{:root{{--bg:#0e1017;--panel:#161a24;--ink:#e7e9f2;--mut:#9aa0b4;--line:#262c3a;--accent:#8b8ff5;--code:#1d2230;--shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.35)}}}}\n:root[data-theme=dark]{{--bg:#0e1017;--panel:#161a24;--ink:#e7e9f2;--mut:#9aa0b4;--line:#262c3a;--accent:#8b8ff5;--code:#1d2230;--shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.35)}}\n:root[data-theme=light]{{--bg:#f7f8fb;--panel:#fff;--ink:#1a1d29;--mut:#5b6172;--line:#e3e6ef;--accent:#6366f1;--code:#eef0f7;--shadow:0 1px 2px rgba(20,24,45,.05),0 8px 24px rgba(20,24,45,.05)}}\n*{{box-sizing:border-box}}body{{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}}\n.wrap{{max-width:1080px;margin:0 auto;padding:0 24px 96px}}\ncode{{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.85em;background:var(--code);padding:.06em .4em;border-radius:5px}}\n.num{{font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}}\nheader.hero{{padding:60px 0 28px;border-bottom:1px solid var(--line)}}\n.kick{{font-size:.72rem;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:700}}\nh1{{font-size:clamp(2rem,4.4vw,3rem);line-height:1.05;letter-spacing:-.02em;margin:.28em 0 .3em;text-wrap:balance;font-weight:800}}\nh1 em{{font-style:normal;color:var(--accent)}}\n.lede{{font-size:1.14rem;color:var(--mut);max-width:66ch;margin:0}}\n.stamp{{display:inline-flex;flex-wrap:wrap;gap:6px 14px;margin:16px 0 0;padding:10px 14px;background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:10px;font-size:.83rem}}\n.stamp b{{color:var(--accent)}}\nsection{{padding:44px 0 6px;border-bottom:1px solid var(--line)}}\nh2{{font-size:1.5rem;letter-spacing:-.01em;margin:0 0 4px;font-weight:750}}\n.sub{{color:var(--mut);margin:.1em 0 1.3em;max-width:68ch}}\n.grid2{{display:grid;grid-template-columns:1fr 1fr;gap:20px}}@media(max-width:760px){{.grid2{{grid-template-columns:1fr}}}}\n.card{{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:12px 12px 4px}}\n.cf{{margin:0}}.cf figcaption{{font-size:.82rem;color:var(--mut);padding:3px 5px 8px}}\nsvg.chart{{width:100%;height:auto;display:block;overflow:visible}}\n.chart .grid{{stroke:var(--line)}}.chart .vg{{stroke-dasharray:2 3;opacity:.7}}\n.chart .ct{{fill:var(--ink);font:700 13px ui-sans-serif}}.chart .cx,.chart .cy{{fill:var(--mut);font:11px ui-sans-serif}}\n.chart .cyt,.chart .cxt{{fill:var(--mut);font:10px ui-monospace,monospace}}.chart .cyt{{text-anchor:end}}.chart .cxt{{text-anchor:middle}}\n.chart .oom{{fill:#e11d48;font:600 10px ui-sans-serif;text-anchor:middle}}\n.legend{{display:flex;flex-wrap:wrap;gap:8px 18px;margin:14px 2px 2px;font-size:.82rem;color:var(--mut);align-items:center}}\n.lg{{display:inline-flex;align-items:center;gap:6px}}.lg i{{width:15px;height:3px;border-radius:2px}}.cm{{font-family:ui-monospace,monospace;font-size:.78em;opacity:.7}}\ntable{{width:100%;border-collapse:collapse;font-size:.95rem;margin:.2em 0 1em}}\nth,td{{text-align:left;padding:9px 12px;border-bottom:1px solid var(--line)}}\nth{{font-size:.74rem;letter-spacing:.05em;text-transform:uppercase;color:var(--mut);font-weight:650}}\ntr.hi td{{background:color-mix(in srgb,var(--accent) 9%,transparent)}}tbody tr:last-child td{{border-bottom:none}}\n.dot{{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:8px;vertical-align:middle}}\n.badge{{font-size:.72rem;padding:2px 9px;border-radius:20px;font-weight:600;white-space:nowrap}}\n.badge.bad{{background:color-mix(in srgb,var(--bad) 16%,transparent);color:var(--bad)}}.badge.ok{{background:color-mix(in srgb,var(--warn) 18%,transparent);color:var(--warn)}}.badge.best{{background:color-mix(in srgb,var(--good) 16%,transparent);color:var(--good)}}\n.callout{{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:8px 0 20px}}@media(max-width:720px){{.callout{{grid-template-columns:1fr}}}}\n.stat{{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px;box-shadow:var(--shadow)}}\n.stat .big{{font-size:1.9rem;font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1}}\n.stat .lab{{color:var(--mut);font-size:.86rem;margin-top:6px}}\n.stat.jamica .big{{color:var(--accent)}}.stat.bad .big{{color:var(--bad)}}.stat.warn .big{{color:var(--warn)}}\np{{max-width:68ch}}.note{{font-size:.9rem;color:var(--mut)}}\n.warn-box{{background:color-mix(in srgb,var(--warn) 8%,var(--panel));border:1px solid var(--line);border-left:3px solid var(--warn);border-radius:10px;padding:14px 18px;margin:6px 0 14px;font-size:.92rem}}\nul.tk{{max-width:68ch;padding-left:0;list-style:none}}ul.tk li{{padding:7px 0 7px 24px;position:relative;border-bottom:1px solid var(--line)}}\nul.tk li:before{{content:\"\";position:absolute;left:3px;top:14px;width:8px;height:8px;border-radius:50%;background:var(--accent)}}\n.quote{{border-left:3px solid var(--accent);padding:4px 0 4px 16px;margin:14px 0;color:var(--mut);font-style:italic;max-width:68ch}}\nfooter{{padding:34px 0 0;color:var(--mut);font-size:.86rem}}\n.prov{{display:grid;grid-template-columns:150px 1fr;gap:4px 16px;font-size:.9rem;margin-top:8px}}.prov dt{{color:var(--mut)}}.prov dd{{margin:0;font-family:ui-monospace,monospace;font-size:.86em}}\n</style>\n<div class=\"wrap\">\n<header class=\"hero\">\n  <div class=\"kick\">Cross-implementation AMICA · ds004505 · real EEG · bleeding-edge</div>\n  <h1>Chunk size is the <em>hidden variable</em></h1>\n  <p class=\"lede\">On real EEG, the batching knob moves fit time up to ~30× and peak memory up to ~30×.\n  Every implementation is strongly chunk-sensitive; the defaults are footguns. jamica is fastest\n  at every chunk and leanest at full-batch.</p>\n  <div class=\"stamp\"><span><b>Latest main:</b></span><span>jamica <code>df18b5e</code></span><span>scott <code>e15e158</code></span><span>pyamica <code>a8a4d7e</code></span><span>pAMICA <code>0c4da39</code></span><span>Fortran ref <code>665b577</code></span><span>· 25 subj · 64 comp · 100 iters · H100 + 8-core Xeon</span></div>\n</header>\n\n<section>\n  <h2>The correction that motivated this</h2>\n  <p class=\"sub\">A naive comparison uses each library's default batching. pAMICA's default\n  (<code>block_size=512</code>) alone produced a ~15–47× \"gap\" that is a configuration artifact, not an\n  algorithmic one — on the same real subjects, the same pAMICA:</p>\n  <div class=\"callout\">\n    <div class=\"stat bad\"><div class=\"big\">140→9.2s</div><div class=\"lab\">pAMICA on ds004505 (GPU median) from its 512 default to full-batch — a 15× self-speedup from one number.</div></div>\n    <div class=\"stat warn\"><div class=\"big\">~30×</div><div class=\"lab\">Range of every library across the chunk axis on real data. The default is never the optimum, and the optimum flips by device.</div></div>\n    <div class=\"stat jamica\"><div class=\"big\">1.8×</div><div class=\"lab\">jamica's real lead over pAMICA when both run at their own optimum — not tens of ×.</div></div>\n  </div>\n  <table><thead><tr><th><code>block_size</code></th><th>Fit time</th><th>Peak VRAM</th><th></th></tr></thead><tbody>{pamrows()}</tbody></table>\n  <p class=\"note\">pAMICA's torch backend does not auto-tune <code>block_size</code>; reporting its\n  shipped default as \"pAMICA performance\" is what produced the headline gap.</p>\n</section>\n\n<section>\n  <h2>Real GPU curves — fit time &amp; memory</h2>\n  <p class=\"sub\">Every implementation swept across its batching knob on real ds004505 (25-subject\n  median, 100 iterations, H100, latest main). ◯ = each impl's optimum; shaded band = min–max across\n  subjects (the wide small-chunk tails are compile/scheduling variance).</p>\n  <div class=\"grid2\"><div class=\"card\">{c_gt}</div><div class=\"card\">{c_gv}</div></div>\n  {legend(IMPLS)}\n  <ul class=\"tk\" style=\"margin-top:20px\">\n    <li><b>jamica is fastest at every chunk</b> — and its curve is a normal, steep U on real\n    data (29→5 s), <em>not</em> flat (see methodology below).</li>\n    <li><b>Defaults are footguns.</b> Small blocks are catastrophic (scott/pAMICA 140–170 s at 1024);\n    the optimum is per-library and only found by sweeping.</li>\n    <li><b>Full-batch is a memory trap:</b> pyamica <b>28 GB</b> / pAMICA <b>19 GB</b>, and\n    scott-huberty <b>OOMs</b> — while jamica reaches its best time in ~8 GB (≈2 GB when chunked).</li>\n  </ul>\n</section>\n\n<section>\n  <h2>Fair comparison — each at its own optimum</h2>\n  <p class=\"sub\">The authoritative ranking: real ds004505, 25-subject median, every library at\n  <em>its</em> best chunk on the H100.</p>\n  <table><thead><tr><th>Implementation</th><th>Batching</th><th>Fit time</th><th>vs jamica</th><th>Peak VRAM</th></tr></thead><tbody>{optrows()}</tbody></table>\n  <p class=\"note\">jamica leads by <b>1.8×</b> over pAMICA at optima — not the tens-of-× a default\n  comparison implies. jamica also pays the least memory for its speed.</p>\n</section>\n\n<section>\n  <h2>CPU — fit time &amp; memory</h2>\n  <p class=\"sub\">Real ds004505, 8 cores, 5 subjects (fair-share-neutral throttled rerun). Fit-time is\n  the <b>best-of-5 per cell</b> — a least-contended lower bound; memory is allocation-driven, so clean\n  regardless. ◯ = each impl's CPU optimum. Includes the Fortran amica17 reference (CPU-only).</p>\n  <div class=\"grid2\"><div class=\"card\">{c_ct}</div><div class=\"card\">{c_cr}</div></div>\n  {legend(CPU_IMPLS)}\n  <ul class=\"tk\" style=\"margin-top:20px\">\n    <li><b>The optimum flips by device.</b> CPU optima sit at <em>small/mid</em> chunks (jamica 1024,\n    scott/Fortran ~4096, pyamica 16384) — the opposite of the GPU, where full-batch won. Small blocks\n    fit CPU cache; on the H100 they starve the device. A single recommended chunk is wrong.</li>\n    <li><b>jamica is fastest on CPU too</b> — best ~155 s vs scott 164, pAMICA 241, Fortran 589, pyamica 724.</li>\n    <li><b>Full-batch is a memory trap on CPU as well</b> (jamica 21 GB, pyamica 27 GB); the Fortran\n    reference is the leanest everywhere (0.7 GB).</li>\n    <li><b>Extremes fail:</b> pyamica@1024 exceeds the 1-hour runner timeout (~767 eager chunks/iter);\n    scott full-batch OOMs — both absent from the curve.</li>\n  </ul>\n  <div class=\"warn-box\" style=\"margin-top:14px\"><b>Why best-of-5, not the mean.</b> CPU cells ran on\n  shared <code>bycore</code> nodes; AMICA fits are memory-bandwidth-bound, so co-located cells starve\n  each other. Even the throttled rerun (job array, <code>%4</code>) leaves residual contention, and the\n  5 subjects differ in length — so the per-cell <em>median</em> stays non-monotonic. The <em>min</em>\n  across subjects recovers the clean chunk trend. Absolute CPU seconds are approximate; trust the shapes\n  and ordering. Full analysis + noise estimate: <code>NOTES_measurement.md</code>.</div>\n</section>\n\n<section>\n  <h2>Methodology — why the synthetic \"flat curve\" was a mirage</h2>\n  <p class=\"sub\">An earlier synthetic microbenchmark (random data, 20 iters) showed jamica with a\n  suspiciously flat GPU curve. An independent panel (GPT-5.6 + Grok-4.6) and a steady-state\n  re-measurement traced it to a <b>JIT-compile artifact</b>, not robustness.</p>\n  <p>With <code>chunk_size</code> a JIT static argument, each of jamica's fused-scan cells compiled a\n  different program; a fresh-process 20-iter wall clock folds a ~2.5 s compile into every point, which\n  flattens a short run. Splitting compile from steady-state ms/iter (<code>(T₄₀−T₁₀)/30</code>) reveals\n  a normal <b>~19× steady-state spread</b> — jamica is <em>not</em> chunk-robust. The real 100-iteration\n  workload above confirms it: a steep, ordinary U-curve. What jamica genuinely has is a fused in-graph\n  blocked E-step (no Python-per-block penalty), memory-efficient full-batch, a correct <code>auto</code>\n  pick per device, and the fastest real-workload time — not knob-insensitivity.</p>\n  <div class=\"quote\">\"Flattest ⇒ most robust is a self-serving reading of a short, compile-contaminated\n  GPU sweep.\" — adversarial panel synthesis</div>\n</section>\n\n<section>\n  <h2>Release vs main</h2>\n  <p class=\"sub\">All curves above are latest <code>main</code>. Release→main is performance-neutral on\n  GPU (measured identical); jamica's one perf-relevant commit (<code>2cd81e4</code>, \"make CPU fits\n  faster and smaller\") touches the CPU E-step only. Competitor <code>main</code> builds move only\n  through the same batching knob; bumping to main rescues no one's default (pAMICA <code>main</code> is\n  still 140 s at 512). The CPU curves above are the clean throttled <code>main</code> build; a\n  like-for-like release-vs-main CPU comparison at clean concurrency was out of scope for this pass.</p>\n</section>\n\n<footer>\n  <div class=\"kick\" style=\"color:var(--mut)\">Provenance &amp; reproduction</div>\n  <dl class=\"prov\">\n    <dt>Dataset</dt><dd>ds004505 · 25 subjects (GPU) / 5 (CPU) · 64 PCA components</dd>\n    <dt>GPU</dt><dd>NVIDIA H100 80GB · SciNet Trillium (def-kjerbi)</dd>\n    <dt>CPU</dt><dd>8 cores · Alliance fir (rrg-kjerbi_cpu, bycore)</dd>\n    <dt>Commits</dt><dd>jamica df18b5e · scott e15e158 · pyamica a8a4d7e · pAMICA 0c4da39 · Fortran 665b577</dd>\n    <dt>Workload</dt><dd>64 comp · 100 iters · per-subject median</dd>\n    <dt>Runners</dt><dd>results/xperf_chunksize/sweeps/ + submit_cell_cpu.sh (atomic cells, cached input)</dd>\n    <dt>Panel</dt><dd>panel/ (GPT-5.6 + Grok-4.6 + SYNTHESIS)</dd>\n    <dt>Caveats</dt><dd>NOTES_measurement.md (CPU contention + noise estimate)</dd>\n  </dl>\n  <p class=\"note\" style=\"margin-top:16px\">Trust the shapes, the ordering, and each implementation's\n  optimum. GPU absolutes are 25-subject medians; CPU <em>memory</em> is clean; CPU <em>fit-times</em>\n  are best-of-5 (least-contended) from the throttled rerun — approximate absolutes, clean trend.</p>\n</footer>\n</div>\"\"\"\nHERE=os.path.dirname(os.path.abspath(__file__))\n# content version (no <!doctype>/<head>/<body> — the Artifact publish step adds those)\nopen(os.path.join(HERE,\"xperf_chunk_report.html\"),\"w\").write(HTML)\n# standalone version — full document, opens directly in any browser\n_title = HTML.split(\"<title>\",1)[1].split(\"</title>\",1)[0] if \"<title>\" in HTML else \"AMICA chunk-size report\"\nSTANDALONE = ('<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">'\n              '<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">'\n              f'<title>{_title}</title></head><body>\\n{HTML}\\n</body></html>\\n')\nopen(os.path.join(HERE,\"xperf_chunk_report_standalone.html\"),\"w\").write(STANDALONE)\nprint(\"wrote real-data report\", len(HTML), \"bytes (+ standalone\", len(STANDALONE), \"bytes)\")\n","numLines":336,"startLine":1,"totalLines":336}}}
