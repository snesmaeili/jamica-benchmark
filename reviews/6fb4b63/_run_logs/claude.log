{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015SdZwu135rM3h6uA9XGTTV","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Collaborator showcase: real-data (ds004505) fit-time & VRAM vs chunk size, GPU, bleeding-edge.\"\"\"\n3\timport math, os\n4\t\n5\tFULL = 262144\n6\tIMPLS = [\"jamica\", \"pamica\", \"pyamica\", \"scott\"]\n7\tLABEL = {\"jamica\":\"jamica\",\"pamica\":\"pAMICA (sccn)\",\"pyamica\":\"pyamica\",\"scott\":\"scott-huberty\"}\n8\tKNOB  = {\"jamica\":\"chunk_size\",\"pamica\":\"block_size\",\"pyamica\":\"chunk_t\",\"scott\":\"batch_size\"}\n9\tCOMMIT= {\"jamica\":\"df18b5e\",\"pamica\":\"0c4da39\",\"pyamica\":\"a8a4d7e\",\"scott\":\"e15e158\"}\n10\tCOLOR = {\"jamica\":\"#6366f1\",\"pamica\":\"#d97706\",\"pyamica\":\"#0d9488\",\"scott\":\"#e11d48\"}\n11\t# GPU main, median of 25 subjects: chunk -> (median_s, min_s, max_s)\n12\tT = {\n13\t \"jamica\":   {1024:(29.2,20.8,34.7),4096:(11.0,9.1,29.9),16384:(6.8,6.0,43.0),65536:(5.6,5.0,10.5),FULL:(5.2,4.1,30.5)},\n14\t \"pamica\":  {1024:(139.6,99.2,170.4),4096:(36.9,29.2,49.8),16384:(14.3,11.6,40.6),65536:(11.6,8.2,34.5),FULL:(9.2,7.0,33.5)},\n15\t \"pyamica\": {1024:(81.3,58.5,98.8),4096:(21.1,15.0,26.2),16384:(12.7,9.4,15.8),65536:(11.7,8.4,14.3),FULL:(9.7,7.0,12.1)},\n16\t \"scott\":   {1024:(172.4,123.3,213.5),4096:(45.2,36.8,72.4),16384:(15.4,13.3,85.7),65536:(10.1,7.4,16.8)},  # full = OOM\n17\t}\n18\t# VRAM median (GB)\n19\tV = {\n20\t \"jamica\":   {1024:2.19,4096:2.19,16384:2.19,65536:2.19,FULL:8.14},\n21\t \"pamica\":  {1024:0.58,4096:0.64,16384:0.86,65536:1.75,FULL:19.25},\n22\t \"pyamica\": {1024:1.66,4096:1.66,16384:1.66,65536:3.07,FULL:28.30},\n23\t \"scott\":   {1024:0.58,4096:0.62,16384:0.77,65536:1.38},\n24\t}\n25\tdef xlog(c): return math.log2(FULL*4 if c==FULL else c)\n26\tXT=[1024,4096,16384,65536,FULL]; XMIN,XMAX=math.log2(1024)-0.4,xlog(FULL)+0.4\n27\t\n28\tdef chart(get, band, ylab, ylog, title, sub, oom=None):\n29\t    W,H=560,360; ml,mr,mt,mb=58,16,34,54; pw,ph=W-ml-mr,H-mt-mb\n30\t    def X(c): return ml+(xlog(c)-XMIN)/(XMAX-XMIN)*pw\n31\t    allv=[y for im in IMPLS for c in T[im] for y in ([get(im,c)] if get(im,c) else [])]\n32\t    if band: allv+=[b for im in IMPLS for c in T[im] for b in (band(im,c) or [])]\n33\t    vmax=max(allv); vmin=min(v for v in allv if v>0)\n34\t    if ylog:\n35\t        lo,hi=math.log10(vmin*0.8),math.log10(vmax*1.25)\n36\t        def Y(v): return mt+ph-(math.log10(max(v,vmin*0.5))-lo)/(hi-lo)*ph\n37\t    else:\n38\t        hi=vmax*1.1; lo=0\n39\t        def Y(v): return mt+ph-(v-lo)/(hi-lo)*ph\n40\t    s=[f'<svg viewBox=\"0 0 {W} {H}\" class=\"chart\" role=\"img\" aria-label=\"{title}\">']\n41\t    s.append(f'<text x=\"{ml}\" y=\"17\" class=\"ct\">{title}</text>')\n42\t    s.append(f'<text x=\"{ml}\" y=\"{H-6}\" class=\"cx\">chunk / block size (samples) →</text>')\n43\t    s.append(f'<text transform=\"translate(15,{mt+ph/2}) rotate(-90)\" class=\"cy\">{ylab}</text>')\n44\t    if ylog:\n45\t        ticks=[]; d0=1\n46\t        while d0<=vmax*1.25:\n47\t            for m0 in (1,2,5):\n48\t                if vmin*0.7<=d0*m0<=vmax*1.25: ticks.append(d0*m0)\n49\t            d0*=10\n50\t    else: ticks=[hi*i/4 for i in range(5)]\n51\t    for t in ticks:\n52\t        y=Y(t); s.append(f'<line x1=\"{ml}\" y1=\"{y:.1f}\" x2=\"{W-mr}\" y2=\"{y:.1f}\" class=\"grid\"/>')\n53\t        s.append(f'<text x=\"{ml-7}\" y=\"{y+3:.1f}\" class=\"cyt\">{t:.0f}</text>')\n54\t    for c in XT:\n55\t        x=X(c); lab=\"full\" if c==FULL else f'{c//1024}K'\n56\t        s.append(f'<line x1=\"{x:.1f}\" y1=\"{mt}\" x2=\"{x:.1f}\" y2=\"{mt+ph}\" class=\"grid vg\"/>')\n57\t        s.append(f'<text x=\"{x:.1f}\" y=\"{mt+ph+17}\" class=\"cxt\">{lab}</text>')\n58\t    for im in IMPLS:\n59\t        cs=sorted(c for c in T[im] if get(im,c))\n60\t        if band:\n61\t            up=\" \".join(f\"{X(c):.1f},{Y(band(im,c)[1]):.1f}\" for c in cs)\n62\t            dn=\" \".join(f\"{X(c):.1f},{Y(band(im,c)[0]):.1f}\" for c in reversed(cs))\n63\t            s.append(f'<polygon points=\"{up} {dn}\" fill=\"{COLOR[im]}\" opacity=\"0.10\"/>')\n64\t        path=\" \".join(((\"M\" if i==0 else \"L\")+f\"{X(c):.1f},{Y(get(im,c)):.1f}\") for i,c in enumerate(cs))\n65\t        s.append(f'<path d=\"{path}\" fill=\"none\" stroke=\"{COLOR[im]}\" stroke-width=\"2.6\"/>')\n66\t        for c in cs: s.append(f'<circle cx=\"{X(c):.1f}\" cy=\"{Y(get(im,c)):.1f}\" r=\"3.2\" fill=\"{COLOR[im]}\"/>')\n67\t        bc=min(cs,key=lambda k:get(im,k))\n68\t        s.append(f'<circle cx=\"{X(bc):.1f}\" cy=\"{Y(get(im,bc)):.1f}\" r=\"6.5\" fill=\"none\" stroke=\"{COLOR[im]}\" stroke-width=\"2\"/>')\n69\t    if oom:\n70\t        x=X(FULL); s.append(f'<text x=\"{x:.1f}\" y=\"{mt+14}\" class=\"oom\">scott ✕ OOM</text>')\n71\t    s.append('</svg>')\n72\t    return f'<figure class=\"cf\"><figcaption>{sub}</figcaption>{\"\".join(s)}</figure>'\n73\t\n74\tc_t=chart(lambda im,c:(T[im].get(c) or [None])[0], lambda im,c:(T[im][c][1],T[im][c][2]) if c in T[im] else None,\n75\t          \"fit time (s, log) — median of 25\", True, \"Fit time vs chunk size\", \"GPU · H100 · 100 iters · band = min–max across 25 subjects\", oom=True)\n76\tc_v=chart(lambda im,c:V[im].get(c), None, \"peak VRAM (GB)\", False, \"Peak GPU memory vs chunk size\", \"GPU · H100 · median of 25 subjects · full-batch is the memory trap\")\n77\t\n78\tlegend=\"\".join(f'<span class=\"lg\"><i style=\"background:{COLOR[i]}\"></i>{LABEL[i]} <code>{KNOB[i]}</code> <span class=\"cm\">@{COMMIT[i]}</span></span>' for i in IMPLS)\n79\t\n80\tHTML=f\"\"\"<title>AMICA chunk-size on real EEG (bleeding-edge)</title>\n81\t<style>\n82\t:root{{--bg:#f6f7fb;--panel:#fff;--ink:#181b26;--mut:#5a6072;--line:#e4e7f0;--accent:#6366f1;--code:#eef0f7}}\n83\t@media(prefers-color-scheme:dark){{:root{{--bg:#0d0f16;--panel:#161a24;--ink:#e8eaf2;--mut:#9aa0b4;--line:#262c3a;--accent:#8b8ff5;--code:#1d2230}}}}\n84\t:root[data-theme=dark]{{--bg:#0d0f16;--panel:#161a24;--ink:#e8eaf2;--mut:#9aa0b4;--line:#262c3a;--accent:#8b8ff5;--code:#1d2230}}\n85\t:root[data-theme=light]{{--bg:#f6f7fb;--panel:#fff;--ink:#181b26;--mut:#5a6072;--line:#e4e7f0;--accent:#6366f1;--code:#eef0f7}}\n86\t*{{box-sizing:border-box}}body{{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}}\n87\t.wrap{{max-width:1000px;margin:0 auto;padding:40px 24px 72px}}\n88\tcode{{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.84em;background:var(--code);padding:.05em .38em;border-radius:5px}}\n89\t.kick{{font-size:.72rem;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:700}}\n90\th1{{font-size:clamp(1.7rem,3.6vw,2.5rem);line-height:1.06;letter-spacing:-.02em;margin:.25em 0 .3em;font-weight:800;text-wrap:balance}}\n91\t.lede{{font-size:1.08rem;color:var(--mut);max-width:66ch;margin:0 0 6px}}\n92\t.stamp{{display:inline-flex;flex-wrap:wrap;gap:6px 14px;margin:14px 0 4px;padding:10px 14px;background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:10px;font-size:.84rem}}\n93\t.stamp b{{color:var(--accent)}}\n94\t.grid2{{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:22px 0 4px}}\n95\t@media(max-width:760px){{.grid2{{grid-template-columns:1fr}}}}\n96\t.card{{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px 12px 6px;box-shadow:0 1px 2px rgba(20,24,45,.05),0 8px 24px rgba(20,24,45,.05)}}\n97\tsvg.chart{{width:100%;height:auto;display:block;overflow:visible}}.cf{{margin:0}}.cf figcaption{{font-size:.8rem;color:var(--mut);padding:2px 4px 8px}}\n98\t.chart .grid{{stroke:var(--line)}}.chart .vg{{stroke-dasharray:2 3;opacity:.7}}\n99\t.chart .ct{{fill:var(--ink);font:700 13px ui-sans-serif}}.chart .cx,.chart .cy{{fill:var(--mut);font:11px ui-sans-serif}}\n100\t.chart .cyt,.chart .cxt{{fill:var(--mut);font:10px ui-monospace,monospace}}.chart .cyt{{text-anchor:end}}.chart .cxt{{text-anchor:middle}}\n101\t.chart .oom{{fill:#e11d48;font:600 10px ui-sans-serif;text-anchor:middle}}\n102\t.legend{{display:flex;flex-wrap:wrap;gap:8px 20px;margin:14px 2px;font-size:.85rem;color:var(--mut);align-items:center}}\n103\t.lg{{display:inline-flex;align-items:center;gap:6px}}.lg i{{width:16px;height:3px;border-radius:2px}}.cm{{font-family:ui-monospace,monospace;font-size:.76em;opacity:.75}}\n104\t.take{{margin-top:20px;padding:16px 20px;background:var(--panel);border:1px solid var(--line);border-radius:12px}}\n105\t.take b{{color:var(--accent)}}ul{{margin:.4em 0;padding-left:1.1em}}li{{margin:.25em 0;max-width:70ch}}\n106\t.foot{{margin-top:22px;color:var(--mut);font-size:.82rem}}\n107\t</style>\n108\t<div class=\"wrap\">\n109\t  <div class=\"kick\">Cross-implementation AMICA · real EEG · bleeding-edge</div>\n110\t  <h1>Chunk size drives fit time &amp; memory on real data</h1>\n111\t  <p class=\"lede\">The batching knob moves fit time up to <b>~30×</b> and peak VRAM up to <b>~30×</b>.\n112\t  jamica is fastest at every setting and the leanest at full-batch.</p>\n113\t  <div class=\"stamp\"><span><b>Bleeding-edge (latest main):</b></span>\n114\t    <span>jamica <code>df18b5e</code></span><span>scott-huberty <code>e15e158</code></span>\n115\t    <span>pyamica <code>a8a4d7e</code></span><span>pAMICA <code>0c4da39</code></span>\n116\t    <span>· ds004505 · 25 subjects · 64 comps · 100 iters · NVIDIA H100</span></div>\n117\t  <div class=\"grid2\"><div class=\"card\">{c_t}</div><div class=\"card\">{c_v}</div></div>\n118\t  <div class=\"legend\">{legend}<span class=\"lg\">◯ each impl's optimum</span></div>\n119\t  <div class=\"take\">\n120\t    <ul>\n121\t      <li><b>jamica wins at every chunk</b> (optimum <code>full/65536</code> ≈ 5.2 s vs pAMICA 9.2 s, pyamica 9.7 s, scott 10.1 s).</li>\n122\t      <li><b>Defaults are footguns.</b> Small blocks are catastrophic (scott/pAMICA 140–170 s at 1024); the sweet spot is per-implementation and only found by sweeping.</li>\n123\t      <li><b>Full-batch is a memory trap:</b> pyamica <b>28 GB</b> / pAMICA <b>19 GB</b> at full, and scott-huberty <b>OOMs</b> — while jamica reaches its best time in ~8 GB (and stays ~2 GB when chunked).</li>\n124\t    </ul>\n125\t  </div>\n126\t  <p class=\"foot\">Lines are per-subject medians (n=25); shaded band = min–max across subjects (the wide tails at small chunks are compile/scheduling variance). Fortran reference (CPU-only) and the full CPU curves are a separate panel. Runners + data: <code>results/xperf_chunksize/</code>.</p>\n127\t</div>\"\"\"\n128\tHERE=os.path.dirname(os.path.abspath(__file__))\n129\topen(os.path.join(HERE,\"realchunk_gpu_showcase.html\"),\"w\").write(HTML)\n130\tprint(\"wrote showcase\", len(HTML), \"bytes\")\n131\t"}]},"parent_tool_use_id":null,"session_id":"4432191b-ac87-4500-8cd4-5ad89611f7a7","uuid":"85f0316e-d7b0-403e-8535-87e6a03f9b72","timestamp":"2026-08-13T16:03:07.153Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/tmp.3Rd3HvEgNr/benchmark/comparator/results/xperf_chunksize/gen_showcase.py","content":"#!/usr/bin/env python3\n\"\"\"Collaborator showcase: real-data (ds004505) fit-time & VRAM vs chunk size, GPU, bleeding-edge.\"\"\"\nimport math, os\n\nFULL = 262144\nIMPLS = [\"jamica\", \"pamica\", \"pyamica\", \"scott\"]\nLABEL = {\"jamica\":\"jamica\",\"pamica\":\"pAMICA (sccn)\",\"pyamica\":\"pyamica\",\"scott\":\"scott-huberty\"}\nKNOB  = {\"jamica\":\"chunk_size\",\"pamica\":\"block_size\",\"pyamica\":\"chunk_t\",\"scott\":\"batch_size\"}\nCOMMIT= {\"jamica\":\"df18b5e\",\"pamica\":\"0c4da39\",\"pyamica\":\"a8a4d7e\",\"scott\":\"e15e158\"}\nCOLOR = {\"jamica\":\"#6366f1\",\"pamica\":\"#d97706\",\"pyamica\":\"#0d9488\",\"scott\":\"#e11d48\"}\n# GPU main, median of 25 subjects: chunk -> (median_s, min_s, max_s)\nT = {\n \"jamica\":   {1024:(29.2,20.8,34.7),4096:(11.0,9.1,29.9),16384:(6.8,6.0,43.0),65536:(5.6,5.0,10.5),FULL:(5.2,4.1,30.5)},\n \"pamica\":  {1024:(139.6,99.2,170.4),4096:(36.9,29.2,49.8),16384:(14.3,11.6,40.6),65536:(11.6,8.2,34.5),FULL:(9.2,7.0,33.5)},\n \"pyamica\": {1024:(81.3,58.5,98.8),4096:(21.1,15.0,26.2),16384:(12.7,9.4,15.8),65536:(11.7,8.4,14.3),FULL:(9.7,7.0,12.1)},\n \"scott\":   {1024:(172.4,123.3,213.5),4096:(45.2,36.8,72.4),16384:(15.4,13.3,85.7),65536:(10.1,7.4,16.8)},  # full = OOM\n}\n# VRAM median (GB)\nV = {\n \"jamica\":   {1024:2.19,4096:2.19,16384:2.19,65536:2.19,FULL:8.14},\n \"pamica\":  {1024:0.58,4096:0.64,16384:0.86,65536:1.75,FULL:19.25},\n \"pyamica\": {1024:1.66,4096:1.66,16384:1.66,65536:3.07,FULL:28.30},\n \"scott\":   {1024:0.58,4096:0.62,16384:0.77,65536:1.38},\n}\ndef xlog(c): return math.log2(FULL*4 if c==FULL else c)\nXT=[1024,4096,16384,65536,FULL]; XMIN,XMAX=math.log2(1024)-0.4,xlog(FULL)+0.4\n\ndef chart(get, band, ylab, ylog, title, sub, oom=None):\n    W,H=560,360; ml,mr,mt,mb=58,16,34,54; pw,ph=W-ml-mr,H-mt-mb\n    def X(c): return ml+(xlog(c)-XMIN)/(XMAX-XMIN)*pw\n    allv=[y for im in IMPLS for c in T[im] for y in ([get(im,c)] if get(im,c) else [])]\n    if band: allv+=[b for im in IMPLS for c in T[im] for b in (band(im,c) or [])]\n    vmax=max(allv); vmin=min(v for v in allv if v>0)\n    if ylog:\n        lo,hi=math.log10(vmin*0.8),math.log10(vmax*1.25)\n        def Y(v): return mt+ph-(math.log10(max(v,vmin*0.5))-lo)/(hi-lo)*ph\n    else:\n        hi=vmax*1.1; lo=0\n        def Y(v): return mt+ph-(v-lo)/(hi-lo)*ph\n    s=[f'<svg viewBox=\"0 0 {W} {H}\" class=\"chart\" role=\"img\" aria-label=\"{title}\">']\n    s.append(f'<text x=\"{ml}\" y=\"17\" class=\"ct\">{title}</text>')\n    s.append(f'<text x=\"{ml}\" y=\"{H-6}\" class=\"cx\">chunk / block size (samples) →</text>')\n    s.append(f'<text transform=\"translate(15,{mt+ph/2}) rotate(-90)\" class=\"cy\">{ylab}</text>')\n    if ylog:\n        ticks=[]; d0=1\n        while d0<=vmax*1.25:\n            for m0 in (1,2,5):\n                if vmin*0.7<=d0*m0<=vmax*1.25: ticks.append(d0*m0)\n            d0*=10\n    else: ticks=[hi*i/4 for i in range(5)]\n    for t in ticks:\n        y=Y(t); s.append(f'<line x1=\"{ml}\" y1=\"{y:.1f}\" x2=\"{W-mr}\" y2=\"{y:.1f}\" class=\"grid\"/>')\n        s.append(f'<text x=\"{ml-7}\" y=\"{y+3:.1f}\" class=\"cyt\">{t:.0f}</text>')\n    for c in XT:\n        x=X(c); lab=\"full\" if c==FULL else f'{c//1024}K'\n        s.append(f'<line x1=\"{x:.1f}\" y1=\"{mt}\" x2=\"{x:.1f}\" y2=\"{mt+ph}\" class=\"grid vg\"/>')\n        s.append(f'<text x=\"{x:.1f}\" y=\"{mt+ph+17}\" class=\"cxt\">{lab}</text>')\n    for im in IMPLS:\n        cs=sorted(c for c in T[im] if get(im,c))\n        if band:\n            up=\" \".join(f\"{X(c):.1f},{Y(band(im,c)[1]):.1f}\" for c in cs)\n            dn=\" \".join(f\"{X(c):.1f},{Y(band(im,c)[0]):.1f}\" for c in reversed(cs))\n            s.append(f'<polygon points=\"{up} {dn}\" fill=\"{COLOR[im]}\" opacity=\"0.10\"/>')\n        path=\" \".join(((\"M\" if i==0 else \"L\")+f\"{X(c):.1f},{Y(get(im,c)):.1f}\") for i,c in enumerate(cs))\n        s.append(f'<path d=\"{path}\" fill=\"none\" stroke=\"{COLOR[im]}\" stroke-width=\"2.6\"/>')\n        for c in cs: s.append(f'<circle cx=\"{X(c):.1f}\" cy=\"{Y(get(im,c)):.1f}\" r=\"3.2\" fill=\"{COLOR[im]}\"/>')\n        bc=min(cs,key=lambda k:get(im,k))\n        s.append(f'<circle cx=\"{X(bc):.1f}\" cy=\"{Y(get(im,bc)):.1f}\" r=\"6.5\" fill=\"none\" stroke=\"{COLOR[im]}\" stroke-width=\"2\"/>')\n    if oom:\n        x=X(FULL); s.append(f'<text x=\"{x:.1f}\" y=\"{mt+14}\" class=\"oom\">scott ✕ OOM</text>')\n    s.append('</svg>')\n    return f'<figure class=\"cf\"><figcaption>{sub}</figcaption>{\"\".join(s)}</figure>'\n\nc_t=chart(lambda im,c:(T[im].get(c) or [None])[0], lambda im,c:(T[im][c][1],T[im][c][2]) if c in T[im] else None,\n          \"fit time (s, log) — median of 25\", True, \"Fit time vs chunk size\", \"GPU · H100 · 100 iters · band = min–max across 25 subjects\", oom=True)\nc_v=chart(lambda im,c:V[im].get(c), None, \"peak VRAM (GB)\", False, \"Peak GPU memory vs chunk size\", \"GPU · H100 · median of 25 subjects · full-batch is the memory trap\")\n\nlegend=\"\".join(f'<span class=\"lg\"><i style=\"background:{COLOR[i]}\"></i>{LABEL[i]} <code>{KNOB[i]}</code> <span class=\"cm\">@{COMMIT[i]}</span></span>' for i in IMPLS)\n\nHTML=f\"\"\"<title>AMICA chunk-size on real EEG (bleeding-edge)</title>\n<style>\n:root{{--bg:#f6f7fb;--panel:#fff;--ink:#181b26;--mut:#5a6072;--line:#e4e7f0;--accent:#6366f1;--code:#eef0f7}}\n@media(prefers-color-scheme:dark){{:root{{--bg:#0d0f16;--panel:#161a24;--ink:#e8eaf2;--mut:#9aa0b4;--line:#262c3a;--accent:#8b8ff5;--code:#1d2230}}}}\n:root[data-theme=dark]{{--bg:#0d0f16;--panel:#161a24;--ink:#e8eaf2;--mut:#9aa0b4;--line:#262c3a;--accent:#8b8ff5;--code:#1d2230}}\n:root[data-theme=light]{{--bg:#f6f7fb;--panel:#fff;--ink:#181b26;--mut:#5a6072;--line:#e4e7f0;--accent:#6366f1;--code:#eef0f7}}\n*{{box-sizing:border-box}}body{{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}}\n.wrap{{max-width:1000px;margin:0 auto;padding:40px 24px 72px}}\ncode{{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.84em;background:var(--code);padding:.05em .38em;border-radius:5px}}\n.kick{{font-size:.72rem;letter-spacing:.15em;text-transform:uppercase;color:var(--accent);font-weight:700}}\nh1{{font-size:clamp(1.7rem,3.6vw,2.5rem);line-height:1.06;letter-spacing:-.02em;margin:.25em 0 .3em;font-weight:800;text-wrap:balance}}\n.lede{{font-size:1.08rem;color:var(--mut);max-width:66ch;margin:0 0 6px}}\n.stamp{{display:inline-flex;flex-wrap:wrap;gap:6px 14px;margin:14px 0 4px;padding:10px 14px;background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:10px;font-size:.84rem}}\n.stamp b{{color:var(--accent)}}\n.grid2{{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:22px 0 4px}}\n@media(max-width:760px){{.grid2{{grid-template-columns:1fr}}}}\n.card{{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px 12px 6px;box-shadow:0 1px 2px rgba(20,24,45,.05),0 8px 24px rgba(20,24,45,.05)}}\nsvg.chart{{width:100%;height:auto;display:block;overflow:visible}}.cf{{margin:0}}.cf figcaption{{font-size:.8rem;color:var(--mut);padding:2px 4px 8px}}\n.chart .grid{{stroke:var(--line)}}.chart .vg{{stroke-dasharray:2 3;opacity:.7}}\n.chart .ct{{fill:var(--ink);font:700 13px ui-sans-serif}}.chart .cx,.chart .cy{{fill:var(--mut);font:11px ui-sans-serif}}\n.chart .cyt,.chart .cxt{{fill:var(--mut);font:10px ui-monospace,monospace}}.chart .cyt{{text-anchor:end}}.chart .cxt{{text-anchor:middle}}\n.chart .oom{{fill:#e11d48;font:600 10px ui-sans-serif;text-anchor:middle}}\n.legend{{display:flex;flex-wrap:wrap;gap:8px 20px;margin:14px 2px;font-size:.85rem;color:var(--mut);align-items:center}}\n.lg{{display:inline-flex;align-items:center;gap:6px}}.lg i{{width:16px;height:3px;border-radius:2px}}.cm{{font-family:ui-monospace,monospace;font-size:.76em;opacity:.75}}\n.take{{margin-top:20px;padding:16px 20px;background:var(--panel);border:1px solid var(--line);border-radius:12px}}\n.take b{{color:var(--accent)}}ul{{margin:.4em 0;padding-left:1.1em}}li{{margin:.25em 0;max-width:70ch}}\n.foot{{margin-top:22px;color:var(--mut);font-size:.82rem}}\n</style>\n<div class=\"wrap\">\n  <div class=\"kick\">Cross-implementation AMICA · real EEG · bleeding-edge</div>\n  <h1>Chunk size drives fit time &amp; memory on real data</h1>\n  <p class=\"lede\">The batching knob moves fit time up to <b>~30×</b> and peak VRAM up to <b>~30×</b>.\n  jamica is fastest at every setting and the leanest at full-batch.</p>\n  <div class=\"stamp\"><span><b>Bleeding-edge (latest main):</b></span>\n    <span>jamica <code>df18b5e</code></span><span>scott-huberty <code>e15e158</code></span>\n    <span>pyamica <code>a8a4d7e</code></span><span>pAMICA <code>0c4da39</code></span>\n    <span>· ds004505 · 25 subjects · 64 comps · 100 iters · NVIDIA H100</span></div>\n  <div class=\"grid2\"><div class=\"card\">{c_t}</div><div class=\"card\">{c_v}</div></div>\n  <div class=\"legend\">{legend}<span class=\"lg\">◯ each impl's optimum</span></div>\n  <div class=\"take\">\n    <ul>\n      <li><b>jamica wins at every chunk</b> (optimum <code>full/65536</code> ≈ 5.2 s vs pAMICA 9.2 s, pyamica 9.7 s, scott 10.1 s).</li>\n      <li><b>Defaults are footguns.</b> Small blocks are catastrophic (scott/pAMICA 140–170 s at 1024); the sweet spot is per-implementation and only found by sweeping.</li>\n      <li><b>Full-batch is a memory trap:</b> pyamica <b>28 GB</b> / pAMICA <b>19 GB</b> at full, and scott-huberty <b>OOMs</b> — while jamica reaches its best time in ~8 GB (and stays ~2 GB when chunked).</li>\n    </ul>\n  </div>\n  <p class=\"foot\">Lines are per-subject medians (n=25); shaded band = min–max across subjects (the wide tails at small chunks are compile/scheduling variance). Fortran reference (CPU-only) and the full CPU curves are a separate panel. Runners + data: <code>results/xperf_chunksize/</code>.</p>\n</div>\"\"\"\nHERE=os.path.dirname(os.path.abspath(__file__))\nopen(os.path.join(HERE,\"realchunk_gpu_showcase.html\"),\"w\").write(HTML)\nprint(\"wrote showcase\", len(HTML), \"bytes\")\n","numLines":131,"startLine":1,"totalLines":131}}}
