:root[data-theme=dark]{{--bg:#0e1017;--panel:#161a24;--ink:#e7e9f2;--mut:#9aa0b4;--line:#262c3a;--accent:#8b8ff5;--code:#1d2230;--shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.35)}}
